{
  "name": "Homework Streaming Desktop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": false,
      "dockerDashComposeVersion": "v2"
    }
  },
  "hostRequirements": {"cpus": 2,"memory": "8gb","storage": "32gb"},
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash scripts/start-vm.sh",
  "forwardPorts": [3000,8765],
  "portsAttributes": {
    "3000": {"label": "Homework audio/video desktop","onAutoForward": "notify","visibility": "public","protocol": "http"},
    "8765": {"label": "Homework CloudDrive bridge","onAutoForward": "silent","visibility": "public","protocol": "http"}
  }
}
